{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "moodle",
  "version": "0.1.0",
  "description": "Consulta tus asignaturas, materiales y fechas de Moodle y estudia con fuentes.",
  "keywords": ["moodle", "estudio", "educacion", "mcp"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Moodle",
        "shortDescription": "Tus asignaturas y apuntes en el contexto de tu IA",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
