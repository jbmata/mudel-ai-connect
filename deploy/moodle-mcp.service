[Unit]
Description=Moodle MCP con autorización por cuenta
After=network-online.target
Wants=network-online.target

[Service]
User=moodle-mcp
Group=moodle-mcp
WorkingDirectory=/opt/moodle-mcp/app
EnvironmentFile=/etc/moodle-mcp.env
ExecStart=/opt/moodle-mcp/venv/bin/python /opt/moodle-mcp/app/moodle_remote.py
Restart=on-failure
RestartSec=5
StateDirectory=moodle-mcp
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moodle-mcp

[Install]
WantedBy=multi-user.target
